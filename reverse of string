Write a program for reverse of string

package com.code.reverse;
import java.util.Scanner;

public class reverse {

    public static void main(String[] args) {
        // Create a Scanner object to read input
        Scanner scanner = new Scanner(System.in);
        
        System.out.println("Enter a string to reverse:");
        // Read the input string
        //String is immutable so it does not have reverse function
        String rev = scanner.nextLine();

        String reversedStr = "";    
        
        // Loop to reverse the string
        //rev.length() means string if name=anshul length=6-1=5 it reverse from 5 index till 0th index
        for (int i = rev.length() - 1; i >= 0; i--) {    
            reversedStr = reversedStr + rev.charAt(i);   //luhsna   passing index at character at specific index 
        }    
        
        // Output the results
        System.out.println("Original string: " + rev);    
        System.out.println("Reversed string: " + reversedStr);   
        
        // Close the scanner
        scanner.close();
        
        //using Stringbuffer  String buffer is mutable it has reverse function
        StringBuffer sf=new StringBuffer(rev);
        System.out.println(sf.reverse());
    }
}
